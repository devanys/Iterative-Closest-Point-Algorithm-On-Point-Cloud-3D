import numpy as np
from scipy.spatial import cKDTree
from scipy.optimize import linear_sum_assignment


class ICP:
    def __init__(self, max_iterations=50, convergence_threshold=1e-6):
        self.max_iterations = max_iterations
        self.convergence_threshold = convergence_threshold
        self.transformation_history = []
        self.error_history = []

    def find_correspondences(self, source, target):
        tree = cKDTree(target)
        distances, indices = tree.query(source)

        return indices, distances

    def estimate_transformation(self, source, target):
        centroid_source = np.mean(source, axis=0)
        centroid_target = np.mean(target, axis=0)

        source_centered = source - centroid_source
        target_centered = target - centroid_target

        H = source_centered.T @ target_centered

        U, S, Vt = np.linalg.svd(H)

        R = Vt.T @ U.T

        if np.linalg.det(R) < 0:
            Vt[-1, :] *= -1
            R = Vt.T @ U.T

        t = centroid_target - R @ centroid_source

        return R, t

    def compute_error(self, source, target, indices):
        corresponding_target = target[indices]
        diff = source - corresponding_target
        mse = np.mean(np.sum(diff ** 2, axis=1))
        return mse

    def register(self, source, target, verbose=False):
        self.transformation_history = []
        self.error_history = []

        source_current = source.copy()
        target = target.copy()

        prev_error = float('inf')

        for iteration in range(self.max_iterations):
            indices, distances = self.find_correspondences(source_current, target)

            R, t = self.estimate_transformation(source_current, target[indices])

            error = self.compute_error(source_current, target, indices)
            self.error_history.append(error)

            self.transformation_history.append((R.copy(), t.copy()))

            if verbose:
                print(f"Iteration {iteration + 1}: Error = {error:.6f}, "
                      f"Error change = {abs(prev_error - error):.6f}")

            if abs(prev_error - error) < self.convergence_threshold:
                if verbose:
                    print(f"Converged at iteration {iteration + 1}")
                break

            source_current = source_current @ R.T + t
            prev_error = error

        R_final, t_final = self._compute_cumulative_transform(source, source_current)

        return R_final, t_final, source_current, iteration + 1

    def _compute_cumulative_transform(self, source_original, source_transformed):
        R, t = self.estimate_transformation(source_original, source_transformed)
        return R, t

    def transform_points(self, points, R, t):
        return points @ R.T + t


class FastICP(ICP):
    def __init__(self, max_iterations=50, convergence_threshold=1e-6,
                 subsample_ratio=0.1):
        super().__init__(max_iterations, convergence_threshold)
        self.subsample_ratio = subsample_ratio

    def subsample(self, points):
        n_points = int(len(points) * self.subsample_ratio)
        indices = np.random.choice(len(points), n_points, replace=False)
        return points[indices]

    def register(self, source, target, verbose=False):
        source_sub = self.subsample(source)
        target_sub = self.subsample(target)

        R, t, _, iterations = super().register(source_sub, target_sub, verbose)

        source_transformed = source @ R.T + t

        return R, t, source_transformed, iterations
